{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "zhixueban-prototype",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8765", "--directory", "prototype"],
      "port": 8765
    },
    {
      "name": "zhixueban-backend",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--port", "8000"],
      "cwd": "backend",
      "port": 8000
    },
    {
      "name": "zhixueban-frontend",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8766", "--directory", "frontend"],
      "port": 8766
    }
  ]
}
