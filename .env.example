# 复制为 .env 后按需修改（docker compose 自动读取）

# 学生端（旧版 Web）对外端口：http://<服务器IP>:8080
KNOACT_HTTP_PORT=8080

# 家长端对外端口：http://<服务器IP>:8081
KNOACT_PARENT_PORT=8081

# Flutter 学生端（Web）对外端口：http://<服务器IP>:8082
KNOACT_STUDENT_PORT=8082

# 时区：影响每日 03:00 任务生成与「今天」的判定
TZ=Asia/Shanghai

# MySQL（compose 内置 mysql 服务，仅容器网络内可访问）
# 部署前务必把两个密码改成强密码；密码含 @ : / ? % 时需 URL 编码（如 @ 写成 %40）
MYSQL_DATABASE=zhixueban
MYSQL_USER=knoact
MYSQL_PASSWORD=change-me-app
MYSQL_ROOT_PASSWORD=change-me-root

# ---------- 构建与拉取加速（可选，按机房自选；不配则用 Dockerfile 官方默认）----------
# Docker 拉取 mysql/nginx/python：在宿主机配置，支持多个镜像站（逗号分隔）
#   MIRROR_URLS=https://你的ID.mirror.aliyuncs.com,https://docker.m.daocloud.io \
#     sh scripts/docker-registry-mirrors.sh
# MySQL 镜像名（配好 Hub 加速后默认即可）
# MYSQL_IMAGE=mysql:8.4

# Debian apt（默认 deb.debian.org = 不替换源）
# APT_MIRROR=mirrors.aliyun.com
# APT_MIRROR=mirrors.tencent.com
# APT_MIRROR=mirrors.ustc.edu.cn

# pip（backend / render 构建）
# PIP_INDEX_URL=https://pypi.org/simple/
# PIP_TRUSTED_HOST=pypi.org
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
# PIP_TRUSTED_HOST=mirrors.aliyun.com
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple/
# PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn

# Flutter Web 镜像构建（student-app）；主源失败时会用 FALLBACK 再试一次
# PUB_HOSTED_URL=https://pub.dev
# FLUTTER_STORAGE_BASE_URL=https://storage.googleapis.com
# PUB_HOSTED_URL=https://pub.flutter-io.cn
# FLUTTER_STORAGE_BASE_URL=https://storage.flutter-io.cn
# PUB_FALLBACK_URL=https://pub.dev
# FLUTTER_FALLBACK_STORAGE=https://storage.googleapis.com

# student-app 运行阶段基础镜像（构建时 FROM；Hub 慢可用 DaoCloud 等代理）
# 勿写空行 NGINX_IMAGE=，否则会覆盖 Dockerfile 默认值导致构建失败
# NGINX_IMAGE=nginx:1.27-alpine
# NGINX_IMAGE=docker.m.daocloud.io/library/nginx:1.27-alpine

# --- 国内 ECS 速填示例（取消下面 5 行注释；Docker 加速器仍建议单独配置）---
# APT_MIRROR=mirrors.aliyun.com
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
# PIP_TRUSTED_HOST=mirrors.aliyun.com
# PUB_HOSTED_URL=https://pub.flutter-io.cn
# FLUTTER_STORAGE_BASE_URL=https://storage.flutter-io.cn
# 国内 mirror 不含 pdfrx 等包；须保留 FALLBACK（默认 pub.dev），构建阶段会用其补拉后再 --no-pub 编译
# PUB_FALLBACK_URL=https://pub.dev
# FLUTTER_FALLBACK_STORAGE=https://storage.googleapis.com

# AI / TTS 的 provider 与密钥不走环境变量，部署后在家长端「设置」页配置（存数据库）

# ---------- 牛题库 tiku.cn（B2B API，向官方商务索取密钥与路径说明）----------
# TIKU_CN_API_BASE=https://api.example.tiku.cn
# TIKU_CN_APP_KEY=
# TIKU_CN_SEARCH_PATH=/api/question/search
# TIKU_CN_TIMEOUT=15

# 学库宝 xuekubao（按知识点 knowledgeId 拉题，请求头 x-api-key）
# 学库宝：也可在家长端「设置 → 题库来源」写入（写入 model_config 表，优先于环境变量）
# XUEKUBAO_API_BASE=https://api.xuekubao.com
# XUEKUBAO_ACCESS_KEY=
# XUEKUBAO_TIMEOUT=30

# 科大讯飞 TTS（家长在「模型与服务」配置；旧版键：tts_app_id / tts_key=APIKey / tts_api_secret）
# 控制台：https://console.xfyun.cn  服务：在线语音合成（流式）WebAPI

# ---------- 账号与 JWT（P0 / ID-04）----------
# 生产环境：JWT_SECRET 必须改为长随机串（例如 openssl rand -hex 32），切勿使用 dev 默认值。
# docker compose 会传入 backend 容器；本地 uvicorn 亦需在 shell 或 .env 中 export。
JWT_SECRET=

# 种子数据（python -m app.seed）：无 password_hash 的用户及默认 admin 账号使用的初始密码。
# 生产环境请改为强密码；默认 admin 登录名为 admin，首次上线后应在运营后台或 /api/admin 修改。
ADMIN_INITIAL_PASSWORD=

# 可选：访问令牌有效期（秒）与刷新令牌天数（见 backend/app/services/security.py、routers/auth.py）
# JWT_ACCESS_TTL=3600
# JWT_REFRESH_DAYS=30

# 遗留「仅姓名」登录（开发联调用）；生产勿设为 1
# KNOACT_LEGACY_NAME_LOGIN=0
