# 复制为 .env 后按需修改（docker compose 自动读取）

# 学生端（旧版 Web）对外端口：http://<服务器IP>:8080
KNOACT_HTTP_PORT=8080

# 家长端对外端口：http://<服务器IP>:8081
KNOACT_PARENT_PORT=8081

# 时区：影响每日 03:00 任务生成与「今天」的判定
TZ=Asia/Shanghai

# 数据库：默认 SQLite（存在 knoact-data 卷）。改用 MySQL 时取消注释并填写：
# DATABASE_URL=mysql+pymysql://user:password@mysql-host:3306/zhixueban?charset=utf8mb4

# AI / TTS 的 provider 与密钥不走环境变量，部署后在家长端「设置」页配置（存数据库）
