# 复制为 .env 后按需修改（docker compose 自动读取）

# 学生端（旧版 Web）对外端口：http://<服务器IP>:8080
KNOACT_HTTP_PORT=8080

# 家长端对外端口：http://<服务器IP>:8081
KNOACT_PARENT_PORT=8081

# Flutter 学生端（Web）对外端口：http://<服务器IP>:8082
KNOACT_STUDENT_PORT=8082

# 时区：影响每日 03:00 任务生成与「今天」的判定
TZ=Asia/Shanghai

# MySQL（compose 内置 mysql 服务，仅容器网络内可访问）
# 部署前务必把两个密码改成强密码；密码含 @ : / ? # % 时需 URL 编码（如 @ 写成 %40）
MYSQL_DATABASE=zhixueban
MYSQL_USER=knoact
MYSQL_PASSWORD=change-me-app
MYSQL_ROOT_PASSWORD=change-me-root

# AI / TTS 的 provider 与密钥不走环境变量，部署后在家长端「设置」页配置（存数据库）

# ---------- 账号与 JWT（P0 / ID-04）----------
# 生产环境：JWT_SECRET 必须改为长随机串（例如 openssl rand -hex 32），切勿使用 dev 默认值。
# docker compose 会传入 backend 容器；本地 uvicorn 亦需在 shell 或 .env 中 export。
JWT_SECRET=

# 种子数据（python -m app.seed）：无 password_hash 的用户及默认 admin 账号使用的初始密码。
# 生产环境请改为强密码；默认 admin 登录名为 admin，首次上线后应在运营后台或 /api/admin 修改。
ADMIN_INITIAL_PASSWORD=

# 可选：访问令牌有效期（秒）与刷新令牌天数（见 backend/app/services/security.py、routers/auth.py）
# JWT_ACCESS_TTL=3600
# JWT_REFRESH_DAYS=30

# 遗留「仅姓名」登录（开发联调用）；生产勿设为 1
# KNOACT_LEGACY_NAME_LOGIN=0

# 可选：docker build 时 pip 源（国内默认阿里云；海外可改为 https://pypi.org/simple）
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
# PIP_TRUSTED_HOST=mirrors.aliyun.com
