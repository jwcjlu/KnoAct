# shell 脚本必须保持 LF：CRLF 会让 Linux 报 "bad interpreter: /usr/bin/env bash^M"
*.sh    text eol=lf
*.bash  text eol=lf

# 容器/nginx 配置同理（挂载进容器后按 LF 解析）
Dockerfile      text eol=lf
*.conf          text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf

# Windows 侧脚本保持 CRLF，免得到 PowerShell 里换行错乱
*.ps1   text eol=crlf

# 二进制/资源文件不做换行转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.pdf   binary
*.db    binary
*.sqlite binary
